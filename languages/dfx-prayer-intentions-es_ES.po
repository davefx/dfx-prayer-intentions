#. Plugin Name of the plugin
#: dfx-prayer-intentions.php
msgid "DFX Prayer Intentions – Prayer Requests for Small Groups"
msgstr "DFX Prayer Intentions – Peticiones de oración para grupos pequeños"

#. Plugin URI of the plugin
#: dfx-prayer-intentions.php
msgid "https://github.com/davefx/dfx-prayer-intentions"
msgstr "https://github.com/davefx/dfx-prayer-intentions"

#. Description of the plugin
#: dfx-prayer-intentions.php
msgid "Collect, moderate and share the prayer intentions of small intercession groups: public request form, lifecycle by type, WhatsApp-ready index and daily digest."
msgstr "Recoge, modera y difunde las intenciones de oración de grupos pequeños de intercesión: formulario público de peticiones, ciclo de vida según el tipo, índice listo para WhatsApp y resumen diario."

#. Author of the plugin
#: dfx-prayer-intentions.php
msgid "David Marín Carreño"
msgstr "David Marín Carreño"

#. Author URI of the plugin
#: dfx-prayer-intentions.php
msgid "https://davefx.com"
msgstr "https://davefx.com"

