<?xml version="1.0"?>
<ruleset name="DFX Prayer Intentions">
	<description>WordPress coding standards, plus the sniffs that catch real defects: unescaped output, unprepared SQL, missing nonces, and syntax that would fail on the declared PHP floor.</description>

	<file>dfx-prayer-intentions.php</file>
	<file>uninstall.php</file>
	<file>includes</file>
	<file>admin</file>
	<file>templates</file>
	<file>blocks</file>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg value="sp"/>
	<arg name="parallel" value="8"/>

	<config name="testVersion" value="8.1-"/>
	<rule ref="PHPCompatibilityWP"/>

	<config name="minimum_wp_version" value="6.5"/>

	<rule ref="WordPress">
		<!-- Class files are named after the class, WordPress style, but with the plugin prefix dropped. -->
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
		<!-- Custom tables are the point: they keep intentions out of search, REST and exporters. -->
		<exclude name="WordPress.DB.DirectDatabaseQuery.DirectQuery"/>
		<exclude name="WordPress.DB.DirectDatabaseQuery.NoCaching"/>
		<exclude name="WordPress.DB.DirectDatabaseQuery.SchemaChange"/>
		<!-- Short array syntax is not used; long syntax is enforced. -->
		<exclude name="Universal.Arrays.DisallowShortArraySyntax.Found"/>
		<!-- Short ternaries read fine. -->
		<exclude name="Universal.Operators.DisallowShortTernary.Found"/>
	</rule>

	<!-- block.json names the asset file after the script: editor.asset.php. -->
	<rule ref="WordPress.Files.FileName.NotHyphenatedLowercase">
		<exclude-pattern>blocks/*/*.asset.php</exclude-pattern>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="dfx-prayer-intentions"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="dfxpray"/>
				<element value="DFXPRAY"/>
			</property>
		</properties>
	</rule>
</ruleset>
